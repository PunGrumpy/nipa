{
  "name": "nipa-cli",
  "version": "0.1.5",
  "description": "The command-line interface for Nipa Cloud",
  "keywords": [
    "cli",
    "keystone",
    "mfa",
    "nipa-cloud",
    "openstack",
    "terraform",
    "totp"
  ],
  "homepage": "https://github.com/PunGrumpy/nipa#readme",
  "bugs": {
    "url": "https://github.com/PunGrumpy/nipa/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Noppakorn Kaewsalabnil",
    "url": "https://www.pungrumpy.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PunGrumpy/nipa.git",
    "directory": "packages/cli"
  },
  "bin": {
    "nipa": "dist/nipa.js"
  },
  "files": [
    "dist/nipa.js",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "bun src/index.ts",
    "build": "bun build src/index.ts --compile --minify --outfile dist/nipa",
    "build:npm": "bun build src/index.ts --target=node --minify --outfile dist/nipa.js",
    "build:release": "bun scripts/build-release.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check:package": "bun run build:npm && publint",
    "prepack": "bun run build:npm"
  },
  "devDependencies": {
    "@inquirer/confirm": "6.3.2",
    "@inquirer/input": "5.1.6",
    "@inquirer/password": "5.2.2",
    "@inquirer/select": "5.2.5",
    "@types/bun": "1.4.2",
    "picocolors": "1.1.1",
    "typescript": "6.0.3",
    "zod": "4.6.5"
  },
  "preferGlobal": true,
  "engines": {
    "node": ">=22.13.0"
  }
}
