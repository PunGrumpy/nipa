{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "description": "The showcase site for nipa",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:cloudflare": "next build && cf-wrangler build",
    "deploy": "bun run build:cloudflare && cf deploy --prebuilt",
    "deploy:preview": "next build && CLOUDFLARE_PREVIEW_BUILD=true cf-wrangler build && cf previews deploy --prebuilt",
    "deploy:ci": "if [ \"$CLOUDFLARE_PREVIEW_BUILD\" = \"true\" ]; then cf previews deploy --prebuilt; else cf deploy --prebuilt; fi",
    "typecheck": "next typegen && tsc-ts --noEmit"
  },
  "dependencies": {
    "geist": "1.7.2",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "cf": "1.0.0-beta.14",
    "tailwindcss": "4.3.3",
    "tsc-ts": "0.0.3",
    "typescript": "7.0.2",
    "wrangler": "4.149.0"
  }
}
