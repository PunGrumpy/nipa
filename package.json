{
  "name": "nipa-monorepo",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "build:npm": "turbo run build:npm",
    "build:release": "turbo run build:release",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "changeset": "changeset",
    "version": "changeset version && bun run fix",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "eslint-plugin-github": "6.1.2",
    "eslint-plugin-sonarjs": "^4.2.2",
    "husky": "^9.1.7",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "turbo": "^2.11.7",
    "ultracite": "7.12.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.2",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "bun@1.4.2"
}
